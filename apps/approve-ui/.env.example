# Optional. Identity UI defaults to the Vite `/id-api` proxy → http://127.0.0.1:8788
# VITE_IDENTITY_LOOP_BASE=http://127.0.0.1:8788
# UI-only smoke without identity-loop (also: /identity?mock=1)
# VITE_IDENTITY_MOCK=1

# WhatsApp UI defaults to the Vite `/wa-api` proxy → http://127.0.0.1:8789
# VITE_WHATSAPP_LOOP_BASE=http://127.0.0.1:8789
# UI-only smoke without whatsapp-loop (also: /whatsapp?mock=1)
# VITE_WHATSAPP_MOCK=1
